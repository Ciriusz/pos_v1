create or replace function calculate_tax()
returns trigger as $$
begin
  new.tax := new.total * 0.19;
  return new;
end;
$$ language plpgsql;
create trigger trg_calculate_tax
before insert on sales
for each row
execute function calculate_tax();
alter table sales enable row level security;

create policy "User can access own sales"
on sales
for all
using (auth.uid() = user_id);
 alter table sale_details enable row level security;

create policy "Access details by owner"
on sale_details
for all
using (
  exists (
    select 1 from sales
    where sales.id = sale_details.sale_id
    and sales.user_id = auth.uid()
  )
);
